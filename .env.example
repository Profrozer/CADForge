# CADForge — optional environment defaults
#
# API keys are normally entered in the app (Settings ⚙ → per provider) and are
# stored in your browser's localStorage only — the server never persists them.
# Nothing here is required; these exist for reference / future automation.
#
# Anthropic (Claude)        https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI (GPT + Codex)      https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
#
# Zhipu AI (GLM)            https://open.bigmodel.cn/
# GLM_API_KEY=...
#
# NVIDIA NIM                https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-...
#
# Ollama needs no key — just a running server (default http://localhost:11434)

# Backend port (default 8000) / frontend dev port (default 5173)
# CADFORGE_BACKEND_PORT=8000
